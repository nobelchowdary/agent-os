diff --git a/internal/model/run_test.go b/internal/model/run_test.go
new file mode 100644
index 0000000..94bd96e
--- /dev/null
+++ b/internal/model/run_test.go
@@ -0,0 +1,93 @@
+package model
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestReasonCodeVocabularyAndDefaults(t *testing.T) {
+	codes := []ReasonCode{ReasonCompleted, ReasonTaskError, ReasonDeadlineExceeded, ReasonCancelled,
+		ReasonOOMKilled, ReasonEvicted, ReasonImagePullFailed, ReasonPolicyDenied,
+		ReasonBudgetExceeded, ReasonInfraFailure, ReasonUnknown}
+	for _, code := range codes {
+		if !code.Valid() {
+			t.Errorf("declared code %q is invalid", code)
+		}
+	}
+	for _, code := range []ReasonCode{"", "OOMKilled", "custom", " task_error", "TASK_ERROR"} {
+		if code.Valid() {
+			t.Errorf("accepted undeclared code %q", code)
+		}
+	}
+	for _, state := range []State{Queued, Starting, Activating, Running, Cancelling, Succeeded, Failed, Cancelled, "unknown"} {
+		want := map[State]ReasonCode{Succeeded: ReasonCompleted, Failed: ReasonUnknown, Cancelled: ReasonCancelled}[state]
+		if got := DefaultReasonCode(state); got != want {
+			t.Errorf("default for %s = %q, want %q", state, got, want)
+		}
+	}
+}
+
+func TestReasonCodesAreOptionalForLegacyRecordsAndEvents(t *testing.T) {
+	var legacy Record
+	if err := json.Unmarshal([]byte(`{"state":"failed","events":[{"state":"failed","reason":"legacy prose"}]}`), &legacy); err != nil {
+		t.Fatal(err)
+	}
+	if legacy.ReasonCode != "" || legacy.Events[0].ReasonCode != "" {
+		t.Fatal("reading legacy JSON invented a historical cause")
+	}
+	encoded, err := json.Marshal(legacy)
+	if err != nil || strings.Contains(string(encoded), "reason_code") {
+		t.Fatalf("legacy omissions did not remain optional: %s, %v", encoded, err)
+	}
+	legacy.ReasonCode, legacy.Events[0].ReasonCode = ReasonTaskError, ReasonTaskError
+	encoded, err = json.Marshal(legacy)
+	if err != nil || strings.Count(string(encoded), `"reason_code":"task_error"`) != 2 {
+		t.Fatalf("structured record/event causes missing: %s, %v", encoded, err)
+	}
+}
+
+func TestCanTransitionAllStatePairs(t *testing.T) {
+	allowed := map[State][]State{
+		Queued:     {Queued, Starting, Running, Cancelling, Succeeded, Failed},
+		Starting:   {Starting, Activating, Running, Cancelling, Succeeded, Failed},
+		Activating: {Activating, Running, Cancelling, Succeeded, Failed},
+		Running:    {Running, Cancelling, Succeeded, Failed},
+		Cancelling: {Cancelling, Failed, Cancelled},
+		Succeeded:  {Succeeded},
+		Failed:     {Failed},
+		Cancelled:  {Cancelled},
+	}
+	states := []State{Queued, Starting, Activating, Running, Cancelling, Succeeded, Failed, Cancelled, "", "unknown", "RUNNING"}
+	for _, from := range states {
+		for _, to := range states {
+			want := false
+			for _, candidate := range allowed[from] {
+				want = want || candidate == to
+			}
+			if got := CanTransition(from, to); got != want {
+				t.Errorf("CanTransition(%q, %q) = %v; want %v", from, to, got, want)
+			}
+		}
+	}
+}
+
+func TestLifecycleHasNoCyclesExceptIdempotentSelfTransitions(t *testing.T) {
+	states := []State{Queued, Starting, Activating, Running, Cancelling, Succeeded, Failed, Cancelled}
+	var visit func(State, map[State]bool)
+	visit = func(from State, path map[State]bool) {
+		if path[from] {
+			t.Fatalf("lifecycle contains a non-idempotent cycle at %s", from)
+		}
+		path[from] = true
+		defer delete(path, from)
+		for _, to := range states {
+			if from != to && CanTransition(from, to) {
+				visit(to, path)
+			}
+		}
+	}
+	for _, from := range states {
+		visit(from, make(map[State]bool))
+	}
+}
diff --git a/internal/store/integrity.go b/internal/store/integrity.go
new file mode 100644
index 0000000..ae3308f
--- /dev/null
+++ b/internal/store/integrity.go
@@ -0,0 +1,185 @@
+package store
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"unicode/utf8"
+
+	"github.com/nobelchowdary/agent-os/internal/model"
+	bolt "go.etcd.io/bbolt"
+)
+
+func decodeSnapshotJSON(value []byte, target any) error {
+	decoder := json.NewDecoder(bytes.NewReader(value))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return ErrIntegrity
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return ErrIntegrity
+	}
+	return nil
+}
+
+func validIdentity(value string) bool {
+	return len(value) > 0 && len(value) <= maxIdentityBytes && utf8.ValidString(value)
+}
+
+func validateHistory(record model.Record) error {
+	if !validIdentity(record.ID) || !validIdentity(record.TenantID) || !record.State.Valid() ||
+		record.CreatedAt.IsZero() || record.UpdatedAt.Before(record.CreatedAt) ||
+		len(record.Events) == 0 {
+		return ErrIntegrity
+	}
+	for i, event := range record.Events {
+		if !event.State.Valid() || event.At.IsZero() || !utf8.ValidString(event.Reason) ||
+			len(event.Reason) > maxReasonBytes || !validReasonCode(event.State, event.ReasonCode, true) {
+			return ErrIntegrity
+		}
+		if i == 0 {
+			if event.State != model.Queued || !event.At.Equal(record.CreatedAt) || event.ReasonCode != "" {
+				return ErrIntegrity
+			}
+		} else {
+			previous := record.Events[i-1]
+			// Pre-graph stores permitted more nonterminal recovery edges. A
+			// migration must preserve that history, not impose today's graph
+			// retrospectively. Terminal immutability has always been required.
+			if previous.State == event.State || previous.State.Terminal() || event.At.Before(previous.At) {
+				return ErrIntegrity
+			}
+		}
+	}
+	last := record.Events[len(record.Events)-1]
+	if record.State != last.State || !record.UpdatedAt.Equal(last.At) || record.Reason != last.Reason || record.ReasonCode != last.ReasonCode {
+		return ErrIntegrity
+	}
+	return nil
+}
+
+func snapshotRecord(records *bolt.Bucket, id []byte) (model.Record, error) {
+	var record model.Record
+	value := records.Get(id)
+	if value == nil || decodeSnapshotJSON(value, &record) != nil || record.ID != string(id) {
+		return record, ErrIntegrity
+	}
+	return record, nil
+}
+
+// validateSnapshot checks both directions of run/reservation indexes and every
+// present idempotency binding. Records do not retain absent keys, so their loss
+// cannot be inferred here. It never repairs history or normalizes a Spec.
+// Legacy reason omissions remain missing; B-trees bound auxiliary memory.
+func validateSnapshot(tx *bolt.Tx) (BackupInfo, error) {
+	var info BackupInfo
+	version, err := schemaVersion(tx)
+	if err != nil {
+		return info, err
+	}
+	info.SchemaVersion = version
+	records := tx.Bucket(recordsBucket)
+	index := tx.Bucket(tenantIndexBucket)
+	active := tx.Bucket(activeBucket)
+	tenantActive := tx.Bucket(tenantActiveBucket)
+	if err := records.ForEach(func(id, value []byte) error {
+		if value == nil {
+			return ErrIntegrity
+		}
+		record, err := snapshotRecord(records, id)
+		if err != nil || validateHistory(record) != nil {
+			return ErrIntegrity
+		}
+		tenantIndex := index.Bucket([]byte(record.TenantID))
+		if tenantIndex == nil || !bytes.Equal(tenantIndex.Get(orderKey(record)), id) {
+			return ErrIntegrity
+		}
+		reservation := active.Get(id)
+		tenantReservations := tenantActive.Bucket([]byte(record.TenantID))
+		var tenantReservation []byte
+		if tenantReservations != nil {
+			tenantReservation = tenantReservations.Get(id)
+		}
+		if record.State.Terminal() {
+			if reservation != nil || tenantReservation != nil {
+				return ErrIntegrity
+			}
+		} else {
+			if !bytes.Equal(reservation, []byte(record.TenantID)) || !bytes.Equal(tenantReservation, []byte{1}) {
+				return ErrIntegrity
+			}
+			info.ActiveRuns++
+		}
+		info.Runs++
+		return nil
+	}); err != nil {
+		return info, err
+	}
+	if err := eachTenant(index, func(tenant []byte, bucket *bolt.Bucket) error {
+		return bucket.ForEach(func(key, id []byte) error {
+			if id == nil {
+				return ErrIntegrity
+			}
+			record, err := snapshotRecord(records, id)
+			if err != nil || record.TenantID != string(tenant) || !bytes.Equal(key, orderKey(record)) {
+				return ErrIntegrity
+			}
+			return nil
+		})
+	}); err != nil {
+		return info, err
+	}
+	if err := active.ForEach(func(id, tenant []byte) error {
+		record, err := snapshotRecord(records, id)
+		if tenant == nil || err != nil || record.State.Terminal() || record.TenantID != string(tenant) {
+			return ErrIntegrity
+		}
+		return nil
+	}); err != nil {
+		return info, err
+	}
+	if err := eachTenant(tenantActive, func(tenant []byte, bucket *bolt.Bucket) error {
+		return bucket.ForEach(func(id, reserved []byte) error {
+			record, err := snapshotRecord(records, id)
+			if !bytes.Equal(reserved, []byte{1}) || err != nil || record.State.Terminal() || record.TenantID != string(tenant) {
+				return ErrIntegrity
+			}
+			return nil
+		})
+	}); err != nil {
+		return info, err
+	}
+	if err := eachTenant(tx.Bucket(idempotencyBucket), func(tenant []byte, bucket *bolt.Bucket) error {
+		return bucket.ForEach(func(key, value []byte) error {
+			var entry idempotencyEntry
+			if len(key) == 0 || len(key) > maxKeyBytes || value == nil || decodeSnapshotJSON(value, &entry) != nil {
+				return ErrIntegrity
+			}
+			record, err := snapshotRecord(records, []byte(entry.ID))
+			if err != nil || record.TenantID != string(tenant) {
+				return ErrIntegrity
+			}
+			fingerprint, err := specFingerprint(record.Spec)
+			if err != nil || entry.Fingerprint != fingerprint {
+				return ErrIntegrity
+			}
+			return nil
+		})
+	}); err != nil {
+		return info, err
+	}
+	return info, nil
+}
+
+func eachTenant(parent *bolt.Bucket, visit func([]byte, *bolt.Bucket) error) error {
+	return parent.ForEach(func(tenant, value []byte) error {
+		if value != nil || !validIdentity(string(tenant)) {
+			return ErrIntegrity
+		}
+		bucket := parent.Bucket(tenant)
+		if bucket == nil {
+			return ErrIntegrity
+		}
+		return visit(tenant, bucket)
+	})
+}
