    "/v1/runs/{id}/events": {
      "get": {
        "operationId": "events",
        "description": "SSE lifecycle replay then live invalidations. One-based IDs; JSON run events include sequence,run_id,at,state,optional reason and reason_code. Terminal end frame has run_id,state,last_event_id and no id. 60s or256-event rotation;10s heartbeats;4streams/tenant,32total;5s per write. Reconnect after last validated event. Not live stdout, physical-stop fencing or a hard real-time SLO. Stream format defaults to version1; request AgentOS-Events-Version: 2 for optional reason_code. The Python client negotiates this automatically.",
        "responses": {
          "200": {
            "description": "Lifecycle SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "204": {
            "description": "Already caught up with terminal run; no response body."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "description": ""
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Use after OR Last-Event-ID, never both; cannot exceed committed event count."
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 20
            },
            "description": "Last fully consumed lifecycle sequence for this run."
          },
          {
            "name": "AgentOS-Events-Version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "2"
              ],
              "default": "1"
            },
            "description": "Version1 (default) omits reason_code for older strict clients. Version2 includes optional stored reason_code. IDs/replay/end framing are identical."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Administrator-provisioned tenant token. Never put tokens in URLs."
      }
    },
    "schemas": {
      "State": {
        "type": "string",
        "enum": [
          "queued",
          "starting",
          "activating",
          "running",
          "cancelling",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "controller_unavailable",
              "environment_unavailable",
              "execution_disabled",
              "idempotency_conflict",
              "internal_error",
              "invalid_cursor",
              "invalid_environment",
              "invalid_event_version",
              "invalid_idempotency_key",
              "invalid_pagination",
              "invalid_request",
              "logs_unavailable",
              "method_not_allowed",
              "quota_exceeded",
              "route_not_found",
              "run_conflict",
              "run_not_found",
              "sandbox_unavailable",
              "storage_unavailable",
              "stream_limit_exceeded",
              "streaming_unavailable",
              "unauthenticated",
              "unsupported_media_type"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "error"
        ],
        "additionalProperties": false
      },
      "CreateRun": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "items": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^[^\\u0000]*$"
            },
            "description": "Optional command. Each argument <=8192 UTF-8 bytes; total <=16384 UTF-8 bytes. Omit to use administrator default.",
            "x-max-utf8-bytes-total": 16384
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400,
            "description": "Execution budget within the selected administrator maximum. Omit for its default."
          }
        },
        "required": [
          "template"
        ],
        "additionalProperties": false,
        "x-max-body-bytes": 32768,
        "x-contract-valid-example": {
          "template": "python",
          "command": [
            "python",
            "-c",
            "print(1)"
          ],
          "timeout_seconds": 30
        },
        "x-contract-invalid-examples": [
          {
            "template": "python",
            "image": "untrusted"
          },
          {
            "Template": "python"
          },
          {
            "template": "python",
            "command": []
          },
          {
            "template": "python",
            "command": null
          },
          {
            "template": "python",
            "command": [
              "python",
              null
            ]
          },
          {
            "template": "python",
            "timeout_seconds": 0
          },
          {
            "template": "python",
            "timeout_seconds": null
          },
          {
            "template": "python",
            "timeout_seconds": 1.5
          },
          {
            "template": "python",
            "timeout_seconds": true
          },
          {
            "template": "python",
            "runtime_class": "runc"
          },
          {},
          null,
          [],
          {
            "template": "python",
            "command": [
              ""
            ]
          },
          {
            "template": "python",
            "timeout_seconds": 86401
          }
        ]
      },
      "Resources": {
        "type": "object",
        "properties": {
          "cpu_milli": {
            "type": "integer",
            "minimum": 1
          },
          "memory_mib": {
            "type": "integer",
            "minimum": 1
          },
          "disk_mib": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "cpu_milli",
          "memory_mib",
          "disk_mib"
        ],
        "additionalProperties": false
      },
      "RuntimeProfile": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "gvisor",
              "aws-nitro-isolated"
            ]
          },
          "runtime_class": {
            "type": "string"
          },
          "required_handler": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "runtime_class",
          "required_handler"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "reason": {
            "type": "string"
          },
          "reason_code": {
            "$ref": "#/components/schemas/ReasonCode"
          }
        },
        "required": [
          "at",
          "state"
        ],
        "additionalProperties": false
      },
      "Spec": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "runtime_class": {
            "type": "string"
          },
          "runtime_profile": {
            "$ref": "#/components/schemas/RuntimeProfile"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "$ref": "#/components/schemas/Resources"
          },
          "timeout_seconds": {
            "type": "integer"
          }
        },
        "required": [
          "template",
          "image",
          "runtime_class",
          "command",
          "resources",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "tenant_id": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/Spec"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "reason": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "reason_code": {
            "$ref": "#/components/schemas/ReasonCode"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "spec",
          "state",
          "created_at",
          "updated_at",
          "events"
        ],
        "additionalProperties": false
      },
      "RunPage": {
        "type": "object",
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "maxItems": 100
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "runs",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Logs": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "logs": {
            "type": "string",
            "description": "Valid UTF-8, at most limit_bytes bytes, untrusted workload output."
          },
          "limit_bytes": {
            "type": "integer",
            "const": 65536
          }
        },
        "required": [
          "run_id",
          "logs",
          "limit_bytes"
        ],
